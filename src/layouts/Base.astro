---
import '../styles/global.css';
import { GA_ID } from '../site';

interface Props {
  title: string;
  description: string;
  /** Home has section links; the download button always goes to /download. */
  home?: boolean;
}
const { title, description, home = false } = Astro.props;
const base = import.meta.env.BASE_URL;
// Addresses read without .html (GitHub Pages serves /privacy from privacy.html).
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), Astro.site);
---
<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f2f3f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1115" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('assets/icon.png', Astro.site)} />
    <meta property="og:locale" content="zh_TW" />
    <meta name="apple-itunes-app" content="app-id=6813616626" />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}assets/favicon-32.png`} />
    <link rel="apple-touch-icon" href={`${base}assets/apple-touch-icon.png`} />
    <!-- Google Analytics: page views and store clicks; no Google signals or ad personalisation. -->
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
    <script is:inline define:vars={{ GA_ID }}>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      window.gtag('js', new Date());
      window.gtag('config', GA_ID, { allow_google_signals: false, allow_ad_personalization_signals: false });
    </script>
    <slot name="head" />
  </head>
  <body class:list={{ home }}>
    <a class="skip-link" href="#main">跳到主要內容</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={base}>
          <img src={`${base}assets/icon-192.png`} alt="" width="32" height="32" />NIU-Life
        </a>
        <nav class="site-nav" aria-label="主選單">
          <a class="optional" href={`${base}#features`}>功能</a>
          <a class="optional" href={`${base}#faq`}>常見問題</a>
          <a class="optional" href={`${base}#wish`}>許願池</a>
          <a class="optional" href={`${base}about`}>關於我們</a>
        </nav>
        <a class="pill pill-solid header-cta" href={`${base}download`}>下載 App</a>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-links">
          <a href={`${base}about`}>關於我們</a>
          <a href={`${base}privacy`}>隱私權政策</a>
          <a href="mailto:hi@niu-life.app">聯絡我們</a>
        </div>
        <p class="disclaimer">
          NIU-Life 為個人開發的非官方工具，與國立宜蘭大學並無隸屬、合作或授權關係。App Store 是 Apple Inc. 的服務標章；Google Play 是 Google LLC 的商標。
        </p>
        <p class="license">
          © {new Date().getFullYear()} NIU-Life · <a href="https://github.com/qian403/NIU-app/blob/main/LICENSE">iOS</a> 與 <a href="https://github.com/windlessme/niu-app-android/blob/main/LICENSE">Android</a> App 原始碼以 MIT 授權公開
        </p>
      </div>
    </footer>
  </body>
</html>
