---
import StoreButtons from './StoreButtons.astro';
const base = import.meta.env.BASE_URL;
---
<section class="section" id="download" data-scene="下載" aria-labelledby="download-title">
  <div class="wrap">
    <div class="card download reveal">
      <img class="app-icon" src={`${base}assets/icon-192.png`} width="88" height="88" alt="" />
      <h2 id="download-title" class="big">立即下載 NIU-Life</h2>
      <p class="lead">iPhone 與 Android 都有，免費使用。</p>
      <StoreButtons />
    </div>
  </div>
</section>

<style>
  .download { text-align: center; }
  .download .lead { margin-inline: auto; }
  .app-icon { width: 88px; height: 88px; border-radius: 22px; margin: 0 auto 20px; background: #f8f8f8; border: 2px solid var(--ink-line); }
</style>
