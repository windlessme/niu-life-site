---
const base = import.meta.env.BASE_URL;
---
<section class="section" id="download" data-scene="下載" aria-labelledby="download-title">
  <div class="wrap">
    <div class="card download reveal">
      <img class="app-icon" src={`${base}assets/icon-192.png`} width="88" height="88" alt="" />
      <h2 id="download-title" class="big">立即下載 NIU-Life</h2>
      <p class="lead">iPhone 與 Android 都有，免費使用。</p>
      <div class="stores" data-stores>
        <a class="store" data-platform="ios" href="https://apps.apple.com/tw/app/niu-life/id6813616626">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.37 12.62c-.02-2.2 1.8-3.26 1.88-3.31-1.02-1.5-2.62-1.7-3.19-1.72-1.36-.14-2.65.8-3.34.8-.69 0-1.75-.78-2.88-.76-1.48.02-2.85.86-3.61 2.19-1.54 2.67-.39 6.62 1.11 8.79.73 1.06 1.6 2.25 2.75 2.2 1.1-.04 1.52-.71 2.85-.71s1.71.71 2.88.69c1.19-.02 1.94-1.08 2.66-2.14.84-1.23 1.19-2.42 1.21-2.48-.03-.01-2.32-.89-2.34-3.55zM14.17 6.15c.61-.74 1.02-1.76.91-2.78-.88.04-1.94.59-2.57 1.32-.56.65-1.06 1.69-.93 2.69.98.08 1.98-.5 2.59-1.23z"></path></svg>
          <span><small>iPhone 下載</small><strong>App Store</strong></span>
        </a>
        <a class="store" data-platform="android" href="https://play.google.com/store/apps/details?id=me.windless.niulife">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#00d7fe" d="M3.6 2.3c-.2.2-.3.6-.3 1v17.4c0 .4.1.8.3 1l9.7-9.7z"></path><path fill="#ffce00" d="M16.6 15.3L13.3 12l3.3-3.3 3.9 2.2c1.1.6 1.1 1.6 0 2.2z"></path><path fill="#ff3a44" d="M16.6 15.3L13.3 12l-9.7 9.7c.4.4.9.4 1.6.1z"></path><path fill="#00f076" d="M16.6 8.7L5.2 2.2c-.7-.4-1.2-.3-1.6.1l9.7 9.7z"></path></svg>
          <span><small>Android 下載</small><strong>Google Play</strong></span>
        </a>
      </div>
      <div class="platforms">
        <div class="platform"><h3>iOS 版</h3><p>需要 iOS 26.2 以上。支援鎖定畫面小工具與課表即時動態。</p></div>
        <div class="platform"><h3>Android 版</h3><p>需要 Android 8.0 以上。支援主畫面小工具、App 捷徑與上課中通知。</p></div>
      </div>
    </div>
  </div>
</section>

<script>
  // Put the visitor's own store first and highlight it.
  const ua = navigator.userAgent;
  const ios = /iPhone|iPad|iPod/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
  const platform = ios ? 'ios' : /Android/.test(ua) ? 'android' : null;
  if (platform) {
    for (const group of document.querySelectorAll<HTMLElement>('[data-stores]')) {
      const own = group.querySelector<HTMLElement>(`[data-platform="${platform}"]`);
      if (!own) continue;
      own.classList.add('primary');
      group.prepend(own);
    }
  }
</script>

<style>
  .download { text-align: center; }
  .download .lead { margin-inline: auto; }
  .app-icon { width: 88px; height: 88px; border-radius: 22px; margin: 0 auto 20px; background: #f8f8f8; border: 2px solid var(--ink-line); }
  .stores { display: flex; flex-wrap: wrap; gap: 14px; justify-content: center; }
  .store {
    display: inline-flex; align-items: center; gap: 12px; min-width: 210px; padding: 12px 20px;
    border-radius: 16px; text-decoration: none; color: var(--text); background: var(--surface);
    border: 2px solid var(--ink-line); box-shadow: 3px 3px 0 var(--ink-line);
    transition: transform .15s ease, box-shadow .15s ease;
  }
  .store:hover { transform: translate(-1px, -1px); box-shadow: 4px 4px 0 var(--ink-line); }
  .store svg { width: 28px; height: 28px; flex: none; }
  .store span { display: flex; flex-direction: column; line-height: 1.25; text-align: left; }
  .store small { font-size: .78rem; opacity: .75; }
  .store strong { font-size: 1.1rem; }
  .store.primary { background: var(--accent); color: var(--on-accent); }
  .platforms { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin-top: 36px; text-align: left; }
  .platform { background: var(--bg); border-radius: var(--radius); padding: 18px 22px; }
  .platform h3 { margin: 0 0 4px; font-size: 1rem; }
  .platform p { margin: 0; color: var(--muted); font-size: .9rem; }
  @media (max-width: 640px) { .platforms { grid-template-columns: 1fr; } }
</style>
