---
// Pinned while the steps play through; the phone shows each step's screen.
const steps = [
  { title: '今天的課，一眼就知道', screen: 'home', points: ['首頁顯示上課中與下一堂，含時間與教室', '點課程直接開 M 園區', '主畫面小工具、上課前提醒'] },
  { title: '整週課表，一次看完', screen: 'week', points: ['星期與日期、今天整欄標出', '紅線標出現在時間', '週六日有課也放得下'] },
  { title: '校園信箱，不用再開網頁', screen: 'mail', points: ['收信、寫信、回覆與轉寄，支援附件', '登入驗證碼自動辨識', '信件匣、搜尋、搬移與刪除'] },
  { title: '請假，進度看得清楚', screen: 'leave-detail', points: ['在 App 裡申請並上傳證明', '簽核到哪一關、誰簽的都看得到', '被退回時，原因放在最上面'] },
  { title: '圖書館，入館不用找', screen: 'library', points: ['入館 QR Code 與借書條碼', '研究小間、討論室預約', '自動調亮螢幕方便掃描'] },
  { title: 'M 園區與快速點名', screen: 'moodle', points: ['公告、教材、作業、成績與出席', '掃描老師的 QR Code 點名', '作業截止前提醒'] },
];
const base = import.meta.env.BASE_URL;
---
<section class="features" id="features" data-scene="功能" aria-labelledby="features-title">
  <div class="stage">
    <div class="copy">
      <p class="eyebrow">FEATURES</p>
      <h2 id="features-title">NIU-Life 能做什麼</h2>
      <ol class="steps">
        {steps.map((s, i) => (
          <li class:list={['step', { active: i === 0 }]} data-step={i}>
            <button type="button" class="step-head">
              <span class="num">{String(i + 1).padStart(2, '0')}</span>{s.title}
            </button>
            <ul>{s.points.map((p) => <li>{p}</li>)}</ul>
          </li>
        ))}
      </ol>
      <div class="progress" aria-hidden="true"><span></span></div>
    </div>
    <div class="screen" aria-hidden="true">
      <div class="phone">
        <div class="phone-screen">
          {steps.map((s, i) => (
            <img class:list={{ active: i === 0 }} data-step={i} src={`${base}assets/screens/${s.screen}.webp`} alt="" width="540" height="1200" loading={i ? 'lazy' : 'eager'} />
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .features { background: var(--surface); border-block: 1px solid var(--line); }
  .stage { display: grid; grid-template-columns: 1.1fr .9fr; align-items: center; gap: 48px; width: min(var(--max), 100% - 32px); margin-inline: auto; }
  h2 { font-size: clamp(1.7rem, 3.6vw, 2.6rem); margin: 0 0 20px; }
  .steps { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
  .step { border-radius: 16px; padding: 10px 16px; color: var(--muted); transition: background .3s, color .3s; }
  .step-head { all: unset; cursor: pointer; display: flex; align-items: baseline; gap: 12px; font-size: 1.08rem; font-weight: 800; width: 100%; }
  .step-head:focus-visible { outline: 3px solid var(--accent); outline-offset: 4px; border-radius: 6px; }
  .num { font-variant-numeric: tabular-nums; color: var(--accent); font-size: .9rem; }
  .step ul { margin: 6px 0 0; padding: 0 0 0 calc(1.6rem + 12px); list-style: none; display: none; }
  .step li::before { content: "・"; color: var(--accent); }
  .step.active { background: var(--accent-soft); color: var(--text); }
  .step.active ul { display: block; }
  .progress { height: 4px; border-radius: 4px; background: var(--line); margin-top: 18px; overflow: hidden; }
  .progress span { display: block; height: 100%; background: var(--accent); transform-origin: left; transform: scaleX(0); }
  .screen { justify-self: center; width: clamp(200px, 30vh, 300px); }
  .screen img { opacity: 0; transition: opacity .45s ease; }
  .screen img.active { opacity: 1; }
  @media (max-width: 820px) {
    .stage { display: flex; flex-direction: column; gap: 12px; padding-block: 16px 64px; }
    .copy { flex: none; }
    h2 { font-size: 1.5rem; margin-bottom: 8px; }
    .eyebrow { display: none; }
    .step { padding: 6px 12px; }
    .step:not(.active) { display: none; }
    .progress { margin-top: 8px; }
    /* The phone takes whatever height the text leaves. */
    .screen { flex: 1; min-height: 0; width: 100%; display: flex; justify-content: center; }
    .screen .phone { height: 100%; width: auto; max-width: 100%; }
  }
</style>
