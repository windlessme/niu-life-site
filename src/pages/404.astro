---
import Base from '../layouts/Base.astro';
---
<Base noindex title="找不到頁面｜NIU-Life" description="這個頁面不存在。">
  <section class="section">
    <div class="wrap center">
      <p class="eyebrow">404</p>
      <h1 class="big">這裡什麼都沒有。</h1>
      <p><a class="pill pill-solid" href={import.meta.env.BASE_URL}>回首頁</a></p>
    </div>
  </section>
</Base>
