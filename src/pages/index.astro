---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Features from '../components/Features.astro';
import Privacy from '../components/Privacy.astro';
import Faq from '../components/Faq.astro';
import Wish from '../components/Wish.astro';
import Download from '../components/Download.astro';
import { APP_STORE, GOOGLE_PLAY } from '../site';

// Structured data: the site, who runs it, and the app it offers.
const site = Astro.site!.href;
// Other names people search for the app by.
const alternateName = ['宜大 App', '宜大校園通', 'NIU 宜大學生 App', '宜大 Life', 'NIU Life'];
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${site}#website`, url: site, name: 'NIU-Life', alternateName, inLanguage: 'zh-Hant-TW', publisher: { '@id': `${site}#org` } },
    {
      '@type': 'Organization',
      '@id': `${site}#org`,
      name: 'NIU-Life',
      url: site,
      logo: new URL('assets/icon.png', site).href,
      email: 'hi@niu-life.app',
      sameAs: ['https://github.com/qian403/NIU-app', 'https://github.com/windlessme/niu-app-android'],
    },
    {
      '@type': 'MobileApplication',
      name: 'NIU-Life',
      alternateName,
      description: '國立宜蘭大學學生的非官方校園助手：課表、M 園區快速點名、成績、校園信箱、請假與圖書館。',
      url: site,
      image: new URL('assets/icon.png', site).href,
      operatingSystem: 'iOS, Android',
      applicationCategory: 'EducationalApplication',
      inLanguage: 'zh-Hant-TW',
      offers: { '@type': 'Offer', price: 0, priceCurrency: 'TWD' },
      installUrl: [APP_STORE, GOOGLE_PLAY],
      sameAs: [APP_STORE, GOOGLE_PLAY],
      publisher: { '@id': `${site}#org` },
    },
  ],
};
---
<Base
  home
  title="NIU-Life｜宜大 App，宜蘭大學學生的校園助手"
  description="NIU-Life（宜大 Life）是國立宜蘭大學學生的非官方宜大 App 與校園助手：課表、M 園區快速點名、成績、校園信箱、請假與圖書館，iOS 與 Android 都能免費下載。"
>
  <meta name="keywords" content={['NIU-Life', ...alternateName, '宜蘭大學 App', '國立宜蘭大學'].join(',')} slot="head" />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(structuredData)} />
  <Hero />
  <About />
  <Features />
  <Privacy />
  <Faq />
  <Wish />
  <Download />
  <div class="pager" aria-hidden="true">
    <span class="pager-now">1</span> / <span class="pager-total">7</span><span class="pager-name">開場</span>
  </div>
</Base>

<script>
  import '../scripts/story';
</script>
