---
import Base from '../layouts/Base.astro';
import campus from '../data/campus-map/campus.json';
import { details, floorTitle, isRoom, label, levels, type Building, type Overview } from '../scripts/campus-map/data';

// Every building with floor plans; the directory below the map lists their
// rooms for search engines and for reading without the map.
const files = import.meta.glob<{ default: Building }>('../data/campus-map/*.json', { eager: true });
const plans = [...new Set((campus as Overview).buildings.map((b) => b.plan).filter(Boolean))];
const buildings = plans.map((p) => files[`../data/campus-map/${p}.json`].default);
const base = import.meta.env.BASE_URL;
const sortRooms = (a: string, b: string) => a.localeCompare(b, 'zh-Hant', { numeric: true });
---
<Base
  title="宜大校園地圖與教室位置｜NIU-Life"
  description="國立宜蘭大學校園地圖：全校建築總覽，教穡大樓、工學院大樓、時習大樓、格致大樓（電資學院）、電資二館、綜合教學大樓、圖書資訊中心、實驗動物中心與時化學舍的樓層平面圖，可以搜尋教室代碼、教室名稱與系所辦公室。"
>
  <div class="cm" data-cm>
    <div class="cm-map">
      <svg class="cm-svg" aria-label="宜大校園地圖，可拖曳與縮放">
        <g class="cm-world"></g>
        <g class="cm-labels"></g>
      </svg>
      <div class="cm-floors" role="group" aria-label="樓層" hidden></div>
      <div class="cm-controls">
        <button type="button" class="cm-ctl cm-zoom-in" aria-label="放大" title="放大"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></button>
        <button type="button" class="cm-ctl cm-zoom-out" aria-label="縮小" title="縮小"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14" /></svg></button>
        <button type="button" class="cm-ctl cm-fit" aria-label="顯示全部" title="顯示全部"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" /></svg></button>
      </div>
      <div class="cm-naiwa"></div>
      <button type="button" class="cm-naiwa-chip" hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5.5" cy="10" r="2.2"/><circle cx="9.5" cy="5.8" r="2.2"/><circle cx="14.5" cy="5.8" r="2.2"/><circle cx="18.5" cy="10" r="2.2"/><path d="M12 11c-3 0-6 4.2-6 6.6 0 1.7 1.3 2.4 2.7 2.4 1.3 0 2.1-.7 3.3-.7s2 .7 3.3.7c1.4 0 2.7-.7 2.7-2.4C18 15.2 15 11 12 11z"/></svg>
        <span class="cm-naiwa-count">奶娃追蹤</span><small>限時</small>
      </button>
      <div class="cm-naiwa-card" role="dialog" aria-label="奶娃追蹤" hidden></div>
      <div class="cm-naiwa-banner" role="status" hidden><span class="cm-naiwa-banner-text"></span><button type="button">取消</button></div>
      <p class="cm-credit"></p>
      <p class="cm-loading">地圖載入中…</p>
    </div>
    <aside class="cm-panel" aria-label="建築與教室">
      <div class="cm-head">
        <button type="button" class="cm-handle" aria-expanded="false" aria-label="展開清單"><span></span></button>
        <div class="cm-searchbar">
          <button type="button" class="cm-back cm-icon" aria-label="回到全校地圖" title="回到全校地圖" hidden>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
          </button>
          <label class="cm-field">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="M16 16l4 4" /></svg>
            <span class="visually-hidden">搜尋</span>
            <input class="cm-search" type="search" enterkeyhint="search" autocomplete="off" placeholder="搜尋大樓、教室、系所" />
          </label>
        </div>
        <div class="cm-summary" aria-live="polite"></div>
      </div>
      <div class="cm-body"></div>
    </aside>
  </div>

  <section class="wrap cm-directory" aria-labelledby="directory">
    <p class="eyebrow">DIRECTORY</p>
    <h2 id="directory" class="cm-dir-title">教室一覽</h2>
    <p class="cm-dir-lead">
      樓層平面圖依各樓層的緊急逃生平面圖繪製，教室代碼與名稱和現場告示相同。在 NIU-Life App 的「小工具 → 校園地圖」也看得到，課表上的教室可以直接開啟位置。
    </p>
    {buildings.map((b) => (
      <details class="cm-dir">
        <summary><strong>{b.name}</strong><span>{levels(b)}</span></summary>
        {[...b.floors].map((f) => {
          const rooms = f.spaces.filter((s) => isRoom(s) && s.code).sort((x, y) => sortRooms(label(x)!, label(y)!));
          return rooms.length > 0 && (
            <div class="cm-dir-floor">
              <h3>{floorTitle(f.id)}{f.unit && <span>・{f.unit}</span>}</h3>
              <ul>
                {rooms.map((s) => (
                  <li><a href={`${base}map?b=${b.id}&r=${encodeURIComponent(label(s)!)}`}>{label(s)}</a>{details(s).length > 0 && <span>{details(s).join('・')}</span>}</li>
                ))}
              </ul>
            </div>
          );
        })}
      </details>
    ))}
  </section>
</Base>

<script>
  import { start } from '../scripts/campus-map/app';
  const root = document.querySelector<HTMLElement>('[data-cm]');
  if (root) start(root);
</script>

<style is:global>
  /* ── Campus map (/map). The map and panel are built by
     scripts/campus-map/app.ts, so these styles are global. ── */
  .cm {
    --cm-ground: #eceef3;
    --cm-campus: #f7f8fb;
    --cm-green: #dcecd6;
    --cm-sport: #f0e3d3;
    --cm-water: #cfe2f6;
    --cm-other: #dcdfe6;
    --cm-plan: #c9c8f3;
    --cm-plan-edge: #5856d6;
    --cm-restroom: #dcefec;
    --cm-restroom-edge: #a9d3cc;
    --cm-step: #dcdfe6;
    --cm-step-edge: #b9bec9;
    --cm-terrace: #e1eedb;
    --cm-zone: color-mix(in srgb, var(--muted) 10%, var(--surface));
    --cm-room-edge: color-mix(in srgb, var(--accent) 30%, transparent);
    --cm-shadow: 0 6px 18px rgb(20 30 60 / .14);
    --street: 7px;
    --service: 3.5px;
    --path: 1.2px;
    position: relative;
    display: grid;
    grid-template-columns: 380px 1fr;
    height: calc(100svh - var(--header));
    min-height: 480px;
    border-bottom: 1px solid var(--line);
    background: var(--cm-ground);
  }
  @media (prefers-color-scheme: dark) {
    .cm {
      --cm-ground: #14171c;
      --cm-campus: #1b1f26;
      --cm-green: #1d2c22;
      --cm-sport: #33291f;
      --cm-water: #182a3d;
      --cm-other: #2a2f38;
      --cm-plan: #2e2d63;
      --cm-plan-edge: #8f8cf5;
      --cm-restroom: #183330;
      --cm-restroom-edge: #2f5a54;
      --cm-step: #2a2f38;
      --cm-step-edge: #454c58;
      --cm-terrace: #1d2c22;
      --cm-zone: color-mix(in srgb, var(--muted) 14%, var(--surface));
      --cm-shadow: 0 6px 18px rgb(0 0 0 / .45);
    }
  }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  .cm-map { position: relative; grid-column: 2; grid-row: 1; overflow: hidden; }
  .cm-svg { display: block; width: 100%; height: 100%; touch-action: none; cursor: grab; user-select: none; -webkit-user-select: none; }
  .cm-svg.dragging { cursor: grabbing; }
  .cm-loading { position: absolute; inset: 0; display: grid; place-items: center; margin: 0; color: var(--muted); }
  .cm.ready .cm-loading { display: none; }

  /* Overview */
  .cm-ground { fill: var(--cm-ground); }
  .cm-campus { fill: var(--cm-campus); }
  .cm-green { fill: var(--cm-green); }
  .cm-sport { fill: var(--cm-sport); }
  .cm-water { fill: var(--cm-water); }
  .cm-parking { fill: var(--line); }
  .cm-road { fill: none; stroke-linecap: round; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
  .cm-road.cm-fill { stroke: var(--surface); }
  .cm-road.cm-casing { stroke: var(--line); }
  .cm-road.cm-street.cm-fill { stroke-width: var(--street); }
  .cm-road.cm-street.cm-casing { stroke-width: calc(var(--street) + 2px); }
  .cm-road.cm-service.cm-fill { stroke-width: var(--service); }
  .cm-road.cm-service.cm-casing { stroke-width: calc(var(--service) + 2px); }
  .cm-road.cm-path.cm-fill { stroke-width: var(--path); opacity: .9; }
  .cm-building { fill: var(--cm-other); stroke: var(--line); stroke-width: 1px; vector-effect: non-scaling-stroke; }
  .cm-building.cm-ours { fill: var(--accent-soft); stroke: var(--cm-room-edge); cursor: pointer; }
  .cm-building.cm-plan { fill: var(--cm-plan); stroke: var(--cm-plan-edge); cursor: pointer; }
  .cm-building.on { fill: var(--accent); stroke: var(--accent); stroke-width: 2px; }
  .cm-boundary { fill: none; stroke: var(--accent); stroke-width: 2px; vector-effect: non-scaling-stroke; pointer-events: none; }
  .cm-labels { pointer-events: none; }
  .cm-labels text { font-family: inherit; paint-order: stroke; stroke: var(--cm-campus); stroke-width: 3px; stroke-linejoin: round; }
  .cm-name { font-size: 12px; font-weight: 500; fill: var(--text); text-anchor: middle; }
  .cm-name.planned { font-weight: 700; }
  .cm-name.on { font-weight: 800; }

  /* Floor plans */
  .cm-slab { fill: var(--surface); stroke: var(--line); stroke-width: 1px; vector-effect: non-scaling-stroke; }
  .cm-space { vector-effect: non-scaling-stroke; stroke-width: 1px; }
  .cm-corridor { fill: var(--surface); stroke: none; }
  .cm-terrace { fill: var(--cm-terrace); stroke: none; }
  .cm-void { fill: var(--cm-ground); stroke: var(--cm-step-edge); }
  .cm-room { fill: var(--accent-soft); stroke: var(--cm-room-edge); }
  .cm-restroom { fill: var(--cm-restroom); stroke: var(--cm-restroom-edge); }
  .cm-stairs, .cm-elevator { fill: var(--cm-step); stroke: var(--cm-step-edge); }
  .cm-zone { fill: var(--cm-zone); stroke: none; pointer-events: none; }
  .cm-zone-edge { fill: none; stroke: var(--muted); stroke-width: 1.5px; stroke-dasharray: 6 4; vector-effect: non-scaling-stroke; pointer-events: none; }
  .cm-zone-tag { text-anchor: middle; font-size: 11px; font-weight: 600; fill: var(--muted); paint-order: stroke; stroke: var(--surface) !important; stroke-width: 3px; }
  .cm-treads path, .cm-cross { stroke: var(--cm-step-edge); stroke-width: 1px; vector-effect: non-scaling-stroke; fill: none; pointer-events: none; }
  .cm-pick { cursor: pointer; }
  .cm-space.on { fill: var(--accent); stroke: var(--accent); stroke-width: 2px; }
  .cm-code, .cm-room-name { text-anchor: middle; stroke: transparent !important; }
  .cm-code { font-size: 12px; font-weight: 700; fill: var(--text); }
  .cm-room-name { font-size: 11px; font-weight: 500; fill: var(--muted); }
  .cm-code.on, .cm-room-name.on { fill: var(--on-accent); }
  .cm-link rect { fill: color-mix(in srgb, var(--cm-plan-edge) 16%, var(--surface)); }
  .cm-link text { font-size: 12px; font-weight: 600; fill: var(--cm-plan-edge); stroke: transparent !important; }
  .cm-link path { fill: var(--cm-plan-edge); }

  /* Floating controls */
  .cm-floors, .cm-controls { position: absolute; right: 16px; display: flex; flex-direction: column; background: var(--surface); border-radius: 14px; box-shadow: var(--cm-shadow); overflow: hidden; }
  .cm-floors { top: 16px; max-height: calc(100% - 200px); overflow-y: auto; }
  .cm-floors[hidden] { display: none; }
  .cm-controls { bottom: 40px; }
  .cm-floor, .cm-ctl { appearance: none; border: 0; background: none; color: var(--text); font: inherit; cursor: pointer; }
  .cm-floor { min-width: 48px; height: 40px; padding: 0 10px; font-weight: 700; font-size: .9rem; font-variant-numeric: tabular-nums; }
  .cm-floor + .cm-floor, .cm-ctl + .cm-ctl { border-top: 1px solid var(--line); }
  .cm-floor:hover, .cm-ctl:hover { background: var(--bg); }
  .cm-floor.current { background: var(--accent); color: var(--on-accent); }
  .cm-ctl { width: 44px; height: 44px; display: grid; place-items: center; }
  .cm-ctl svg, .cm-icon svg, .cm-field svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .cm-credit { position: absolute; left: 12px; bottom: 8px; margin: 0; font-size: .75rem; color: var(--muted); background: color-mix(in srgb, var(--surface) 80%, transparent); padding: 2px 8px; border-radius: 999px; }
  .cm-credit[hidden] { display: none; }

  /* 奶娃追蹤: markers keep their size at any zoom. */
  .cm { --cm-paw: #b85300; --cm-paw-ink: #fff; }
  @media (prefers-color-scheme: dark) { .cm { --cm-paw: #ffa45c; --cm-paw-ink: #1c1206; } }
  .cm-naiwa { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  .cm-paw { position: absolute; pointer-events: auto; transform: translate(-50%, -50%); width: 32px; height: 32px; padding: 0; display: grid; place-items: center; border: 2px solid #fff; border-radius: 50%; background: var(--cm-paw); color: var(--cm-paw-ink); box-shadow: 0 2px 6px rgb(0 0 0 / .25); cursor: pointer; }
  .cm-paw svg { width: 18px; height: 18px; fill: currentColor; }
  /* Placing a report: taps go through to the map. */
  .cm-naiwa.placing .cm-paw { pointer-events: none; }
  .cm-paw::before { content: ''; position: absolute; inset: -8px; border-radius: 50%; }
  .cm-paw span { position: absolute; top: 31px; left: 50%; transform: translateX(-50%); white-space: nowrap; padding: 1px 7px; border-radius: 999px; background: var(--cm-paw); color: var(--cm-paw-ink); font-size: 11px; font-weight: 700; }
  .cm-naiwa-chip { position: absolute; top: 16px; left: 16px; display: flex; align-items: center; gap: 8px; padding: 6px 14px 6px 6px; border: 0; border-radius: 999px; background: var(--surface); color: var(--text); font: inherit; font-weight: 700; box-shadow: var(--cm-shadow); cursor: pointer; }
  .cm-naiwa-chip[hidden] { display: none; }
  .cm-naiwa-chip svg { width: 30px; height: 30px; padding: 6px; border-radius: 50%; background: var(--cm-paw); fill: var(--cm-paw-ink); }
  .cm-naiwa-chip small { font-size: .75rem; font-weight: 600; color: var(--muted); }
  .cm-naiwa-card { position: absolute; top: 64px; left: 16px; width: min(340px, calc(100% - 32px)); padding: 14px 16px 16px; border-radius: 18px; background: var(--surface); box-shadow: var(--cm-shadow); z-index: 3; }
  .cm-naiwa-card[hidden] { display: none; }
  .cm-naiwa-head { display: flex; gap: 8px; align-items: flex-start; justify-content: space-between; }
  .cm-naiwa-note { margin: 10px 0 4px; font-size: .9rem; color: var(--muted); }
  .cm-naiwa-points { margin: 10px 0 14px; padding-left: 1.2em; font-size: .88rem; line-height: 1.55; color: var(--muted); display: grid; gap: 4px; }
  .cm-naiwa-actions { margin-top: 12px; }
  .cm-paw-pending { border-width: 3px; animation: cm-paw-pulse 1.2s ease-in-out infinite; }
  @keyframes cm-paw-pulse { 50% { transform: translate(-50%, -50%) scale(1.15); } }
  @media (prefers-reduced-motion: reduce) { .cm-paw-pending { animation: none; } }
  .cm-naiwa-banner { position: absolute; left: 50%; bottom: 40px; transform: translateX(-50%); width: min(520px, calc(100% - 32px)); display: flex; align-items: center; gap: 12px; padding: 8px 8px 8px 16px; border-radius: 999px; background: var(--cm-paw); color: var(--cm-paw-ink); font-weight: 700; box-shadow: var(--cm-shadow); z-index: 3; }
  .cm-naiwa-banner[hidden] { display: none; }
  .cm-naiwa-banner span { flex: 1; font-size: .92rem; }
  .cm-naiwa-banner button { appearance: none; border: 0; border-radius: 999px; padding: 6px 14px; background: color-mix(in srgb, var(--cm-paw-ink) 18%, transparent); color: inherit; font: inherit; cursor: pointer; }
  .cm-naiwa-actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .cm-naiwa-actions .pill { font-size: .92rem; padding: 6px 14px; }
  .cm-floor.cm-spotted { position: relative; }
  .cm-floor.cm-spotted::after { content: ''; position: absolute; top: 6px; right: 6px; width: 7px; height: 7px; border-radius: 50%; background: var(--cm-paw); }

  /* Panel */
  .cm-panel { grid-column: 1; grid-row: 1; display: flex; flex-direction: column; min-height: 0; background: var(--surface); border-right: 1px solid var(--line); z-index: 2; }
  .cm-head { padding: 16px 16px 12px; border-bottom: 1px solid var(--line); }
  .cm-handle { display: none; }
  .cm-searchbar { display: flex; gap: 8px; align-items: center; }
  .cm-field { flex: 1; display: flex; align-items: center; gap: 8px; padding: 0 14px; height: 44px; border-radius: 999px; background: var(--bg); border: 1px solid var(--line); color: var(--muted); }
  .cm-field:focus-within { border-color: var(--accent); }
  .cm-search { flex: 1; min-width: 0; border: 0; background: none; color: var(--text); font: inherit; font-size: 16px; outline: none; }
  .cm-icon { appearance: none; flex: none; width: 40px; height: 40px; display: grid; place-items: center; border: 0; border-radius: 999px; background: var(--bg); color: var(--text); cursor: pointer; }
  .cm-icon:hover { background: var(--accent-soft); }
  .cm-icon[hidden] { display: none; }
  .cm-summary { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; margin-top: 14px; min-height: 48px; }
  .cm-summary-text { flex: 1; min-width: 0; }
  .cm-title { margin: 0; font-size: 1.15rem; line-height: 1.35; }
  .cm-sub { margin: 2px 0 0; font-size: .85rem; color: var(--muted); line-height: 1.45; }
  .cm-open { width: 100%; justify-content: center; }
  .cm-body { flex: 1; min-height: 0; overflow-y: auto; padding: 4px 16px 24px; overscroll-behavior: contain; }
  .cm-section { margin-top: 16px; }
  .cm-eyebrow { margin: 0 0 8px 4px; font-size: .75rem; font-weight: 800; letter-spacing: .1em; color: var(--muted); }
  .cm-group { border: 1px solid var(--line); border-radius: 16px; overflow: hidden; }
  .cm-row { appearance: none; display: flex; align-items: center; gap: 12px; width: 100%; padding: 11px 14px; border: 0; background: var(--surface); color: var(--text); font: inherit; text-align: left; cursor: pointer; }
  .cm-row + .cm-row { border-top: 1px solid var(--line); }
  .cm-row:hover { background: var(--bg); }
  .cm-row.current { background: var(--accent-soft); }
  .cm-row-text { flex: 1; min-width: 0; display: grid; }
  .cm-row-title { font-weight: 700; }
  .cm-row-sub { font-size: .85rem; color: var(--muted); line-height: 1.45; }
  .cm-tag { flex: none; font-size: .75rem; font-weight: 700; color: var(--cm-plan-edge); background: color-mix(in srgb, var(--cm-plan-edge) 14%, transparent); padding: 2px 8px; border-radius: 999px; }
  .cm-empty { color: var(--muted); font-size: .9rem; margin: 16px 4px; }

  /* Phones: the map fills the screen and the panel is a drawer whose
     header (handle, search, summary) stays put while the list scrolls. */
  @media (max-width: 820px) {
    .cm { display: block; }
    .cm-map { position: absolute; inset: 0; }
    .cm-panel {
      position: absolute; left: 0; right: 0; bottom: 0; height: 172px;
      border-right: 0; border-radius: 20px 20px 0 0; box-shadow: 0 -4px 20px rgb(0 0 0 / .12);
      transition: height .28s cubic-bezier(.2, .8, .2, 1);
    }
    .cm-head { padding: 0 16px 10px; touch-action: none; }
    .cm-handle { display: grid; place-items: center; width: 100%; height: 22px; border: 0; background: none; cursor: pointer; padding: 0; }
    .cm-handle span { width: 36px; height: 4px; border-radius: 2px; background: var(--line); }
    .cm-summary { margin-top: 10px; min-height: 0; }
    .cm-panel:not(.open) .cm-open { width: auto; padding: 6px 14px; font-size: .9rem; box-shadow: 2px 2px 0 var(--ink-line); }
    .cm-panel:not(.open) .cm-summary { flex-wrap: nowrap; }
    .cm-sub { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .cm-controls { bottom: auto; top: 16px; right: auto; left: 16px; }
    .cm-naiwa-chip { left: 72px; }
    /* The card is a sheet over the drawer; the banner sits just above
       the closed drawer, clear of the zoom buttons and floor picker. */
    .cm-naiwa-card {
      top: auto; left: 0; bottom: 0; width: auto; right: 0; max-height: 78%; overflow-y: auto; overscroll-behavior: contain;
      padding: 16px 16px calc(20px + env(safe-area-inset-bottom)); border-radius: 20px 20px 0 0; box-shadow: 0 -4px 24px rgb(0 0 0 / .18);
    }
    .cm-naiwa-actions { display: grid; grid-template-columns: 1fr 1fr; }
    .cm-naiwa-actions .pill { justify-content: center; min-height: 44px; font-size: 1rem; }
    .cm-naiwa-actions .pill:last-child:nth-child(odd) { grid-column: 1 / -1; }
    .cm-naiwa-card:not([hidden]) ~ .cm-naiwa-banner { display: none; }
    .cm-naiwa-banner { bottom: calc(var(--cm-peek, 172px) + 12px); border-radius: 18px; padding: 10px 10px 10px 16px; }
    .cm-naiwa-banner button { min-height: 40px; }
    .cm-credit { bottom: auto; top: 8px; left: auto; right: 12px; }
  }
  @media (prefers-reduced-motion: reduce) { .cm-panel { transition: none; } }

  /* Directory */
  .cm-directory { padding-block: 56px 24px; max-width: 860px; }
